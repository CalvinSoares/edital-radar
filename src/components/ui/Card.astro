---
interface Props {
  class?: string;
  lift?: boolean;
  /** Sem sombra deslocada (tabelas/listas densas). */
  quiet?: boolean;
}

const { class: extra = "", lift = false, quiet = false } = Astro.props;
---

<div
  class:list={[
    quiet ? "er-card-quiet" : "er-card",
    lift && "er-lift",
    extra,
  ]}
>
  <slot />
</div>
