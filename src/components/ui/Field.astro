---
interface Props {
  name: string;
  label: string;
  type?: "text" | "email" | "password" | "number";
  placeholder?: string;
  erro?: string | undefined;
  required?: boolean;
  min?: string | number;
  max?: string | number;
}

const {
  name,
  label,
  type = "text",
  placeholder,
  erro,
  required = true,
  min,
  max,
} = Astro.props;
const erroId = erro ? `${name}-erro` : undefined;
---

<label class="block">
  <span class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-slate">
    {label}
  </span>
  <input
    name={name}
    type={type}
    placeholder={placeholder}
    required={required}
    min={min}
    max={max}
    aria-invalid={erro ? "true" : undefined}
    aria-describedby={erroId}
    class="w-full rounded-sm border-2 border-borda bg-cartao px-4 py-3 text-tinta outline-none transition-[border-color,box-shadow] duration-200 placeholder:text-slate/70 focus:border-ink focus:ring-2 focus:ring-peach/40"
  />
  {
    erro && (
      <span id={erroId} class="mt-1.5 block text-sm font-medium text-erro" role="alert">
        {erro}
      </span>
    )
  }
</label>
