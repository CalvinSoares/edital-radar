---
import "~/styles/global.css";

interface Props {
  titulo: string;
  descricao?: string;
  /** Se false, robots noindex,nofollow. Default: auto (privado se path for painel/admin/etc.). */
  indexavel?: boolean;
  /** URL canônica absoluta; default = SITE_URL + pathname (sem query). */
  canonical?: string;
  /** Caminho absoluto da imagem OG (ex.: /og.png). */
  imagemOg?: string;
  /** Tipo Open Graph. */
  tipoOg?: "website" | "article";
  /** JSON-LD serializado (objeto ou array). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const site = (import.meta.env.SITE_URL ?? "https://editalradar.com.br").replace(/\/$/, "");
const caminho = Astro.url.pathname.replace(/\/$/, "") || "/";

const privadoPorPadrao =
  caminho.startsWith("/painel") ||
  caminho.startsWith("/admin") ||
  caminho === "/entrar" ||
  caminho.startsWith("/entrar/") ||
  caminho.startsWith("/descadastrar") ||
  caminho.startsWith("/convite") ||
  caminho.startsWith("/api");

const {
  titulo,
  descricao = "Alerta de editais e fomento no Diário Oficial de SP para ONGs e projetos sociais.",
  indexavel = !privadoPorPadrao,
  canonical = `${site}${caminho === "/" ? "/" : caminho}`,
  imagemOg = "/og.png",
  tipoOg = "website",
  jsonLd,
} = Astro.props;

const urlImagem = imagemOg.startsWith("http") ? imagemOg : `${site}${imagemOg}`;
const robots = indexavel ? "index,follow" : "noindex,nofollow";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0F3040" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={tipoOg} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Edital Radar" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={urlImagem} />
    <meta property="og:image:alt" content="Edital Radar — alerta de editais no Diário Oficial de SP" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={urlImagem} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
