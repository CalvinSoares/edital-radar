---
import Base from "~/layouts/Base.astro";

export const prerender = true;
---

<Base titulo="Página não encontrada — Edital Radar">
  <main class="mx-auto max-w-2xl px-4 py-24 text-center">
    <h1 class="font-display text-4xl font-bold text-acento">Essa página não existe</h1>
    <p class="mt-4 text-suave">O endereço pode ter mudado ou a publicação saiu do ar.</p>
    <a href="/" class="mt-8 inline-block rounded-xl bg-acento px-5 py-2.5 font-semibold text-sobre-acento hover:bg-acento-forte">
      Voltar ao início
    </a>
  </main>
</Base>
