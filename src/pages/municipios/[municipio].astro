---
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import Card from "~/components/ui/Card.astro";
import { CATALOGO_DE_TEMAS, temaPorSlug } from "~/server/match/temas";
import { humanizarSlugMunicipio, slugMunicipioValido } from "~/server/seo/municipio";
import { humanizarTitulo } from "~/server/alerta/render";

export const prerender = false;

const municipioSlug = (Astro.params.municipio ?? "").toLowerCase();
if (!slugMunicipioValido(municipioSlug)) {
  Astro.response.status = 404;
}

const nome = humanizarSlugMunicipio(municipioSlug);
const { db } = await import("~/server/db/cliente");
const { listarTematicasPorMunicipio } = await import("~/server/db/repositorios/municipios");
const publicacoes = slugMunicipioValido(municipioSlug)
  ? await listarTematicasPorMunicipio(db, municipioSlug, 15)
  : [];

const nomeTema = (slug: string) => temaPorSlug(slug)?.nome ?? slug;

const formatoDia = new Intl.DateTimeFormat("pt-BR", {
  weekday: "long",
  day: "2-digit",
  month: "2-digit",
  timeZone: "America/Sao_Paulo",
});
const porDia = new Map<string, typeof publicacoes>();
for (const p of publicacoes) {
  const dia = formatoDia.format(p.dataPublicacao);
  porDia.set(dia, [...(porDia.get(dia) ?? []), p]);
}

Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=3600");
---

{
  !slugMunicipioValido(municipioSlug) ? (
    <Base titulo="Página não encontrada — Edital Radar" indexavel={false}>
      <SiteHeader ativo="municipios" />
      <main id="conteudo" class="mx-auto max-w-2xl px-4 py-24 text-center">
        <h1 class="font-display text-4xl font-bold tracking-tight text-ink">Essa página não existe</h1>
        <a href="/municipios" class="mt-8 inline-block font-medium text-tinta underline decoration-acento decoration-2 underline-offset-4">
          Ver municípios
        </a>
      </main>
    </Base>
  ) : (
    <Base
      titulo={`${nome} no Diário Oficial de SP — últimos 15 dias | Edital Radar`}
      descricao={`Chamamentos, fomento e credenciamentos publicados no Diário Oficial para ${nome}. Atualizado todo dia útil.`}
      tipoOg="article"
      jsonLd={{
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: `${nome} no Diário Oficial de SP`,
        description: `Chamamentos e fomento publicados no Diário Oficial para ${nome}.`,
        isPartOf: { "@type": "WebSite", name: "Edital Radar" },
      }}
    >
      <SiteHeader ativo="municipios" />
      <main id="conteudo" class="mx-auto max-w-2xl px-4 py-12 md:max-w-3xl md:py-16">
        <nav class="text-sm text-suave">
          <a href="/municipios" class="font-medium text-tinta underline decoration-acento decoration-2 underline-offset-4">
            Municípios
          </a>
          {" › "}
          {nome}
        </nav>
        <h1 class="font-display mt-4 text-3xl font-bold tracking-tight text-ink md:text-5xl">
          {nome}
        </h1>
        <p class="mt-3 text-suave">
          O que saiu nos últimos 15 dias pra quem atua aqui. Filtre por tema:
        </p>
        <p class="mt-2 flex flex-wrap gap-2 text-sm">
          {CATALOGO_DE_TEMAS.map((t) => (
            <a
              href={`/temas/${t.slug}/${municipioSlug}`}
              class="rounded-sm border border-borda bg-cartao px-3 py-1.5 font-medium text-tinta transition-colors hover:border-ink hover:bg-ink hover:text-sobre-acento"
            >
              {t.nome}
            </a>
          ))}
        </p>

        {publicacoes.length === 0 ? (
          <Card class="mt-8">
            <p class="font-semibold">Nada nos últimos 15 dias</p>
            <p class="mt-1 text-suave">
              Nenhuma publicação temática deste município no período — e isso
              também é informação.
            </p>
          </Card>
        ) : (
          [...porDia.entries()].map(([dia, doDia]) => (
            <section class="mt-8">
              <h2 class="font-display text-lg font-semibold capitalize text-suave">{dia}</h2>
              <ul class="mt-3 space-y-3">
                {doDia.map((p) => (
                  <li class="er-card er-lift">
                    <p class="text-xs uppercase tracking-wide text-suave">{nomeTema(p.tema)}</p>
                    <p class="mt-1 font-semibold">{humanizarTitulo(p.titulo)}</p>
                    {p.excerpt && <p class="mt-2 text-sm text-suave">{p.excerpt.slice(0, 220)}…</p>}
                    <a
                      class="mt-2 inline-block text-sm font-medium text-tinta underline decoration-clay decoration-2 underline-offset-4 hover:decoration-ink"
                      href={`https://www.doe.sp.gov.br/${p.slug}`}
                    >
                      ver na fonte
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        )}

        <Card class="mt-10 border-acento/30 bg-acento-suave">
          <p class="font-semibold">Quer aviso quando sair algo em {nome}?</p>
          <p class="mt-1 text-sm text-suave">
            Cadastre o nome da cidade ou da ONG — grátis, avisa por e-mail.
          </p>
          <a
            href="/entrar"
            class="mt-4 inline-block rounded-sm bg-acento px-5 py-2.5 font-semibold text-sobre-acento transition-colors hover:bg-acento-forte"
          >
            Quero receber no e-mail
          </a>
        </Card>
      </main>
    </Base>
  )
}
