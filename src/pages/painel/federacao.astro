---
import { actions } from "astro:actions";
import Base from "~/layouts/Base.astro";
import Card from "~/components/ui/Card.astro";
import Field from "~/components/ui/Field.astro";
import Button from "~/components/ui/Button.astro";
import { obterContextoPainel } from "~/shared/sessao";
import VistaAdminBar from "~/components/VistaAdminBar.astro";

export const prerender = false;

const sessao = await obterContextoPainel(Astro.cookies);
if (!sessao) return Astro.redirect("/entrar");

const resultado = Astro.getActionResult(actions.federacao.convidar);
if (resultado && !resultado.error) {
  return Astro.redirect("/painel/federacao?enviado=1");
}
const erro = resultado?.error?.message;
const enviado = Astro.url.searchParams.get("enviado") === "1";
const resultadoSairVista = Astro.getActionResult(actions.admin.sairDaVista);
if (resultadoSairVista && !resultadoSairVista.error) {
  return Astro.redirect("/admin/assinantes");
}

const { db } = await import("~/server/db/cliente");
const { obterFederacaoDoAdmin, listarAssentos } = await import(
  "~/server/db/repositorios/federacao"
);
const fed = await obterFederacaoDoAdmin(db, sessao.assinanteId);
const assentos = fed ? await listarAssentos(db, fed.id) : [];
---

<Base titulo="Federação — Edital Radar">
  {sessao.vistaAdmin && <VistaAdminBar email={sessao.email} />}
  <main class="mx-auto max-w-2xl px-4 py-16">
    <p class="text-sm text-suave">
      <a href="/painel" class="font-medium text-tinta underline decoration-clay decoration-2 underline-offset-4 hover:decoration-ink">← Painel</a>
    </p>
    <h1 class="font-display mt-2 text-3xl font-bold tracking-tight text-ink">Federação</h1>
    <p class="mt-1 text-suave">Rede com assentos Radar para ONGs afiliadas.</p>

    {
      !fed ? (
        <Card class="mt-8">
          <p class="text-suave">
            Você não administra uma federação. Isso é criado pelo backoffice
            (admin → Federações).
          </p>
        </Card>
      ) : (
        <>
          <Card class="mt-8">
            <h2 class="font-display text-xl font-semibold">{fed.nome}</h2>
            <p class="mt-1 text-sm text-suave">
              {fed.usados}/{fed.assentos} assentos usados
            </p>
            <ul class="mt-4 space-y-2">
              {assentos.map((a) => (
                <li class="rounded-sm border border-borda px-4 py-2 text-sm">
                  <span class="font-semibold">{a.email}</span>
                  <span class="ml-2 text-suave">{a.plano}</span>
                </li>
              ))}
            </ul>
          </Card>

          {fed.usados < fed.assentos && (
            <Card class="mt-8">
              <h2 class="font-display text-xl font-semibold">Convidar ONG</h2>
              {enviado && (
                <p class="mt-2 text-sm text-acento">Convite enviado.</p>
              )}
              <form method="POST" action={actions.federacao.convidar} class="mt-4 space-y-4">
                <Field name="email" label="E-mail" type="email" required />
                {erro && <p class="text-sm text-erro">{erro}</p>}
                <Button>Enviar convite</Button>
              </form>
            </Card>
          )}
        </>
      )
    }
  </main>
</Base>
