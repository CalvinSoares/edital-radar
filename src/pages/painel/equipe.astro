---
import { actions } from "astro:actions";
import Base from "~/layouts/Base.astro";
import Card from "~/components/ui/Card.astro";
import Field from "~/components/ui/Field.astro";
import Button from "~/components/ui/Button.astro";
import { obterContextoPainel } from "~/shared/sessao";
import VistaAdminBar from "~/components/VistaAdminBar.astro";
import { LIMITE_MEMBROS_EQUIPE } from "~/server/db/repositorios/equipe";

export const prerender = false;

const sessao = await obterContextoPainel(Astro.cookies);
if (!sessao) return Astro.redirect("/entrar");

const resultadoConvite = Astro.getActionResult(actions.equipe.convidar);
if (resultadoConvite && !resultadoConvite.error) {
  return Astro.redirect("/painel/equipe?enviado=1");
}
const erroConvite = resultadoConvite?.error?.message;

const resultadoRemover = Astro.getActionResult(actions.equipe.removerMembro);
if (resultadoRemover && !resultadoRemover.error) {
  return Astro.redirect("/painel/equipe");
}
const resultadoSairVista = Astro.getActionResult(actions.admin.sairDaVista);
if (resultadoSairVista && !resultadoSairVista.error) {
  return Astro.redirect("/admin/assinantes");
}

const { db } = await import("~/server/db/cliente");
const {
  obterEquipeDoAssinante,
  listarMembros,
  garantirEquipeDoDono,
} = await import("~/server/db/repositorios/equipe");

let eqp = await obterEquipeDoAssinante(db, sessao.assinanteId);
if (!eqp && !sessao.vistaAdmin) {
  const id = await garantirEquipeDoDono(db, sessao.assinanteId);
  eqp = await obterEquipeDoAssinante(db, sessao.assinanteId);
  if (!eqp) {
    eqp = {
      equipeId: id,
      nome: "Minha ONG",
      donoAssinanteId: sessao.assinanteId,
      papel: "dono",
    };
  }
}

const membros = eqp ? await listarMembros(db, eqp.equipeId) : [];
const ehDono = eqp?.donoAssinanteId === sessao.assinanteId;
const enviado = Astro.url.searchParams.get("enviado") === "1";
---

<Base titulo="Equipe — Edital Radar">
  {sessao.vistaAdmin && <VistaAdminBar email={sessao.email} />}
  <main id="conteudo" class="mx-auto max-w-2xl px-4 py-16">
    <p class="text-sm text-suave">
      <a href="/painel" class="font-medium text-tinta underline decoration-clay decoration-2 underline-offset-4 hover:decoration-ink">← Painel</a>
    </p>
    <h1 class="font-display mt-2 text-3xl font-bold tracking-tight text-ink">Conta compartilhada</h1>
    <p class="mt-1 text-suave">
      Até {LIMITE_MEMBROS_EQUIPE} pessoas (você + 2). Quem entra vê os mesmos avisos da equipe.
    </p>

    {
      <>
        <Card class="mt-8">
          <h2 class="font-display text-xl font-semibold">{eqp?.nome ?? "Minha ONG"}</h2>
          <p class="mt-1 text-sm text-suave">
            {membros.length}/{LIMITE_MEMBROS_EQUIPE} pessoas · você é{" "}
            {ehDono ? "dono(a)" : "membro"}
          </p>
          <ul class="mt-4 space-y-2">
            {membros.map((m) => (
              <li class="flex items-center justify-between gap-3 rounded-sm border border-borda px-4 py-2">
                <span>
                  <span class="font-semibold">{m.email}</span>
                  <span class="ml-2 text-sm text-suave">{m.papel}</span>
                </span>
                {ehDono && m.papel === "membro" && (
                  <form method="POST" action={actions.equipe.removerMembro}>
                    <input type="hidden" name="assinanteId" value={m.assinanteId} />
                    <button type="submit" class="text-sm text-suave hover:text-erro">
                      remover
                    </button>
                  </form>
                )}
              </li>
            ))}
          </ul>
        </Card>

        {ehDono && membros.length < LIMITE_MEMBROS_EQUIPE && (
          <Card class="mt-8">
            <h2 class="font-display text-xl font-semibold">Convidar</h2>
            {enviado && (
              <p class="mt-2 text-sm text-acento">Convite enviado (confira o e-mail / dry-run no log).</p>
            )}
            <form method="POST" action={actions.equipe.convidar} class="mt-4 space-y-4">
              <Field name="email" label="E-mail do colega" type="email" required />
              {erroConvite && <p class="text-sm text-erro">{erroConvite}</p>}
              <Button>Enviar convite</Button>
            </form>
          </Card>
        )}
      </>
    }
  </main>
</Base>
