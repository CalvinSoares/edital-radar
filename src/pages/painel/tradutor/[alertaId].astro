---
import { actions } from "astro:actions";
import Base from "~/layouts/Base.astro";
import Card from "~/components/ui/Card.astro";
import Button from "~/components/ui/Button.astro";
import { obterContextoPainel } from "~/shared/sessao";
import VistaAdminBar from "~/components/VistaAdminBar.astro";
import { humanizarTitulo } from "~/server/alerta/render";
import {
  montarChecklist,
  resumirChecklist,
  type RespostaChecklist,
} from "~/server/tradutor/checklist";

export const prerender = false;

const sessao = await obterContextoPainel(Astro.cookies);
if (!sessao) return Astro.redirect("/entrar");

const { alertaId } = Astro.params;
if (!alertaId || !/^[0-9a-f-]{36}$/.test(alertaId)) {
  return Astro.redirect("/painel");
}

const resultado = Astro.getActionResult(actions.tradutor.salvarChecklist);
if (resultado && !resultado.error) {
  return Astro.redirect(`/painel/tradutor/${alertaId}?salvo=1`);
}
const resultadoSairVista = Astro.getActionResult(actions.admin.sairDaVista);
if (resultadoSairVista && !resultadoSairVista.error) {
  return Astro.redirect("/admin/assinantes");
}

const { db } = await import("~/server/db/cliente");
const { obterAlertaParaTradutor, obterChecklist } = await import(
  "~/server/db/repositorios/tradutor"
);
const aviso = await obterAlertaParaTradutor(db, sessao.assinanteId, alertaId);
if (!aviso) {
  Astro.response.status = 404;
}

const respostasSalvas = aviso
  ? await obterChecklist(db, sessao.assinanteId, alertaId)
  : {};
const itens = aviso ? montarChecklist(aviso.titulo) : [];
const resumo = aviso ? resumirChecklist(itens, respostasSalvas) : null;
const salvo = Astro.url.searchParams.get("salvo") === "1";

const opcoes: { valor: RespostaChecklist; rotulo: string }[] = [
  { valor: "sim", rotulo: "Sim" },
  { valor: "nao", rotulo: "Não" },
  { valor: "nao_sei", rotulo: "Não sei" },
];
---

<Base titulo="Serve pra mim? — Edital Radar">
  {sessao.vistaAdmin && <VistaAdminBar email={sessao.email} />}
  <main id="conteudo" class="mx-auto max-w-2xl px-4 py-16">
    <p class="text-sm text-suave">
      <a href="/painel" class="font-medium text-tinta underline decoration-clay decoration-2 underline-offset-4 hover:decoration-ink">← Painel</a>
    </p>

    {
      !aviso ? (
        <h1 class="font-display mt-4 text-3xl font-bold text-acento">Aviso não encontrado</h1>
      ) : (
        <>
          <h1 class="font-display mt-2 text-3xl font-bold text-acento">Serve pra mim?</h1>
          <p class="mt-1 text-suave">
            Checklist rápido — sem IA. Ajuda a decidir se vale montar pasta.
          </p>

          <Card class="mt-8">
            <p class="font-semibold">{humanizarTitulo(aviso.titulo)}</p>
            {aviso.resumo && <p class="mt-2 text-sm text-tinta">{aviso.resumo}</p>}
            <p class="mt-2 text-sm text-suave">{aviso.trecho}</p>
            <p class="mt-3 text-sm">
              <a
                class="font-medium text-tinta underline decoration-clay decoration-2 underline-offset-4 hover:decoration-ink"
                href={`https://www.doe.sp.gov.br/${aviso.slug}`}
              >
                Ler publicação na fonte
              </a>
            </p>
          </Card>

          {salvo && resumo && resumo.tom !== "incompleto" && (
            <Card class="mt-6">
              <p class="font-semibold text-acento">Resumo</p>
              <p class="mt-2 text-sm text-tinta">{resumo.texto}</p>
            </Card>
          )}

          <form method="POST" action={actions.tradutor.salvarChecklist} class="mt-8 space-y-6">
            <input type="hidden" name="alertaId" value={aviso.id} />
            {itens.map((item) => (
              <fieldset class="rounded-card border border-borda bg-cartao p-5">
                <legend class="px-1 font-semibold">{item.pergunta}</legend>
                {item.dica && <p class="mt-1 text-sm text-suave">{item.dica}</p>}
                <div class="mt-3 flex flex-wrap gap-4">
                  {opcoes.map((o) => (
                    <label class="flex items-center gap-2 text-sm">
                      <input
                        type="radio"
                        name={`r_${item.id}`}
                        value={o.valor}
                        required
                        checked={respostasSalvas[item.id] === o.valor}
                      />
                      {o.rotulo}
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
            <Button>Salvar checklist</Button>
          </form>
        </>
      )
    }
  </main>
</Base>
