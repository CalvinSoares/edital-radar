---
import { actions } from "astro:actions";
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import { obterContextoPainel } from "~/shared/sessao";
import VistaAdminBar from "~/components/VistaAdminBar.astro";
import { humanizarTitulo } from "~/server/alerta/render";

export const prerender = false;

const sessao = await obterContextoPainel(Astro.cookies);
if (!sessao) return Astro.redirect("/entrar");

const resultadoRemover = Astro.getActionResult(actions.salvo.remover);
if (resultadoRemover && !resultadoRemover.error) return Astro.redirect("/painel/salvos");
const resultadoSairVista = Astro.getActionResult(actions.admin.sairDaVista);
if (resultadoSairVista && !resultadoSairVista.error) return Astro.redirect("/admin/assinantes");

const { db } = await import("~/server/db/cliente");
const { listarSalvos } = await import("~/server/db/repositorios/salvos");
const salvos = await listarSalvos(db, sessao.assinanteId);

const formatoData = new Intl.DateTimeFormat("pt-BR", {
  day: "2-digit",
  month: "2-digit",
  timeZone: "America/Sao_Paulo",
});
---

<Base titulo="Salvos — Edital Radar">
  {sessao.vistaAdmin && <VistaAdminBar email={sessao.email} />}
  <SiteHeader ativo="painel" compacto />
  <main id="conteudo" class="mx-auto max-w-2xl px-4 py-10 md:py-14">
    <header>
      <p class="text-sm text-suave">
        <a href="/painel" class="font-medium text-tinta underline decoration-acento decoration-2 underline-offset-4">
          ← Painel
        </a>
      </p>
      <h1 class="font-display mt-3 text-3xl font-bold tracking-tight text-ink">Salvei pra depois</h1>
      <p class="mt-1 text-suave">Publicações que você marcou no histórico.</p>
    </header>

    {
      salvos.length === 0 ? (
        <p class="mt-8 text-suave">
          Nada salvo ainda. No histórico do painel, use “Salvar pra depois”.
        </p>
      ) : (
        <ul class="mt-8 space-y-4">
          {salvos.map((s) => (
            <li class="er-card er-lift">
              <p class="font-semibold">{humanizarTitulo(s.titulo)}</p>
              {s.excerpt && <p class="mt-1 text-sm text-suave">{s.excerpt}</p>}
              <p class="mt-2 text-sm text-suave">
                Publicado {formatoData.format(s.dataPublicacao)} · salvo{" "}
                {formatoData.format(s.salvoEm)}
                {" · "}
                <a
                  class="font-medium text-tinta underline decoration-clay decoration-2 underline-offset-4 hover:decoration-ink"
                  href={`https://www.doe.sp.gov.br/${s.slug}`}
                >
                  ver na fonte
                </a>
              </p>
              <form method="POST" action={actions.salvo.remover} class="mt-3">
                <input type="hidden" name="id" value={s.id} />
                <button type="submit" class="text-sm text-suave hover:text-erro">
                  Remover da pasta
                </button>
              </form>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Base>
