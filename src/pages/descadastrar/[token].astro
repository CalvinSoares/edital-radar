---
import Base from "~/layouts/Base.astro";

export const prerender = false;

const { token } = Astro.params;
const tokenValido = typeof token === "string" && /^[0-9a-f-]{36}$/.test(token);

let sucesso = false;
if (tokenValido) {
  const { db } = await import("~/server/db/cliente");
  const { descadastrarPorToken } = await import("~/server/db/repositorios/assinantes");
  sucesso = await descadastrarPorToken(db, token);
}

if (!sucesso) {
  Astro.response.status = 404;
}
---

<Base titulo="Descadastro — Edital Radar">
  <main class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="er-brand text-lg text-ink">Edital Radar</p>
    {
      sucesso ? (
        <>
          <h1 class="font-display mt-4 text-3xl font-bold tracking-tight text-ink">Pronto — você saiu da lista</h1>
          <p class="mt-4 text-suave">
            Não vamos mais mandar avisos neste e-mail. Se mudar de ideia, é só
            se cadastrar de novo.
          </p>
        </>
      ) : (
        <>
          <h1 class="font-display mt-4 text-3xl font-bold tracking-tight text-ink">Esse link não funciona mais</h1>
          <p class="mt-4 text-suave">
            Pode ter expirado. Se ainda estiver chegando e-mail, responde
            qualquer aviso pedindo a remoção.
          </p>
        </>
      )
    }
    <a
      href="/"
      class="mt-8 inline-block rounded-sm bg-acento px-5 py-2.5 font-semibold text-sobre-acento transition-colors hover:bg-acento-forte"
    >
      Voltar ao início
    </a>
  </main>
</Base>
