---
import Base from "~/layouts/Base.astro";

export const prerender = false;

const { token } = Astro.params;
const tokenValido = typeof token === "string" && /^[0-9a-f-]{36}$/.test(token);

let sucesso = false;
if (tokenValido) {
  const { db } = await import("~/server/db/cliente");
  const { descadastrarPorToken } = await import("~/server/db/repositorios/assinantes");
  sucesso = await descadastrarPorToken(db, token);
}

if (!sucesso) {
  Astro.response.status = 404;
}
---

<Base titulo="Descadastro — Edital Radar">
  <main class="mx-auto max-w-2xl px-4 py-24 text-center">
    {
      sucesso ? (
        <>
          <h1 class="font-display text-3xl font-bold text-acento">Pronto, você foi descadastrado</h1>
          <p class="mt-4 text-suave">
            Você não vai mais receber avisos do Edital Radar neste e-mail. Se
            mudar de ideia, é só se cadastrar de novo.
          </p>
        </>
      ) : (
        <>
          <h1 class="font-display text-3xl font-bold text-acento">Esse link não funciona mais</h1>
          <p class="mt-4 text-suave">
            O link de descadastro pode ter expirado. Se você continua recebendo
            e-mails indesejados, responda qualquer aviso pedindo a remoção.
          </p>
        </>
      )
    }
    <a
      href="/"
      class="mt-8 inline-block rounded-xl bg-acento px-5 py-2.5 font-semibold text-sobre-acento hover:bg-acento-forte"
    >
      Voltar ao início
    </a>
  </main>
</Base>
