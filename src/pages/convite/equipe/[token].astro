---
import Base from "~/layouts/Base.astro";
import { COOKIE_DE_SESSAO, opcoesDoCookie } from "~/shared/sessao";

export const prerender = false;

const { token } = Astro.params;
const tokenValido = typeof token === "string" && /^[0-9a-f-]{36}$/.test(token);

if (tokenValido) {
  const { db } = await import("~/server/db/cliente");
  const { aceitarConviteEquipe } = await import("~/server/db/repositorios/equipe");
  const { criarSessao } = await import("~/server/db/repositorios/auth");
  const ok = await aceitarConviteEquipe(db, token);
  if (ok) {
    const sessaoId = await criarSessao(db, ok.assinanteId);
    Astro.cookies.set(COOKIE_DE_SESSAO, sessaoId, opcoesDoCookie());
    return Astro.redirect("/painel/equipe");
  }
}

Astro.response.status = 410;
---

<Base titulo="Convite inválido — Edital Radar">
  <main id="conteudo" class="mx-auto max-w-md px-4 py-24 text-center">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink">Esse convite não vale mais</h1>
    <p class="mt-4 text-suave">
      Pode ter expirado, já ter sido usado, ou a equipe estar cheia.
    </p>
    <a
      href="/entrar"
      class="mt-8 inline-block rounded-sm bg-acento px-5 py-2.5 font-semibold text-sobre-acento hover:bg-acento-forte"
    >
      Entrar no painel
    </a>
  </main>
</Base>
