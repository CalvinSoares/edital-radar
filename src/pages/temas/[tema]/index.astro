---
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import Card from "~/components/ui/Card.astro";
import { temaPorSlug } from "~/server/match/temas";
import { humanizarTitulo } from "~/server/alerta/render";

export const prerender = false;

const tema = temaPorSlug(Astro.params.tema ?? "");
if (!tema) {
  Astro.response.status = 404;
}

const publicacoes = tema
  ? await (async () => {
      const { db } = await import("~/server/db/cliente");
      const { listarPorTema } = await import("~/server/db/repositorios/temas");
      return listarPorTema(db, tema.slug, 15);
    })()
  : [];

const formatoDia = new Intl.DateTimeFormat("pt-BR", {
  weekday: "long",
  day: "2-digit",
  month: "2-digit",
  timeZone: "America/Sao_Paulo",
});
const porDia = new Map<string, typeof publicacoes>();
for (const p of publicacoes) {
  const dia = formatoDia.format(p.dataPublicacao);
  porDia.set(dia, [...(porDia.get(dia) ?? []), p]);
}

function orgaoDe(hierarchy: string | null): string | null {
  const partes = hierarchy?.split(">").map((s) => s.trim()) ?? [];
  return partes[2] ?? partes[1] ?? null;
}

if (tema) {
  Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=3600");
}
---

{
  !tema ? (
    <Base titulo="Página não encontrada — Edital Radar" indexavel={false}>
      <SiteHeader ativo="temas" />
      <main id="conteudo" class="mx-auto max-w-2xl px-4 py-24 text-center">
        <h1 class="font-display text-4xl font-bold tracking-tight text-ink">Essa página não existe</h1>
        <p class="mt-4 text-suave">Esse tema não está no nosso catálogo.</p>
        <a
          href="/temas"
          class="mt-8 inline-block rounded-sm bg-acento px-5 py-2.5 font-semibold text-sobre-acento transition-colors hover:bg-acento-forte"
        >
          Ver temas
        </a>
      </main>
    </Base>
  ) : (
    <Base
      titulo={`${tema.nome} no Diário Oficial de SP — últimos 15 dias | Edital Radar`}
      descricao={`${tema.descricao} Lista atualizada todo dia útil a partir do Diário Oficial do Estado de São Paulo.`}
      tipoOg="article"
      jsonLd={{
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: `${tema.nome} no Diário Oficial de SP`,
        description: tema.descricao,
        isPartOf: { "@type": "WebSite", name: "Edital Radar" },
      }}
    >
      <SiteHeader ativo="temas" />
      <main id="conteudo" class="mx-auto max-w-2xl px-4 py-12 md:max-w-3xl md:py-16">
        <nav class="text-sm text-suave" aria-label="Você está em">
          <a href="/temas" class="font-medium text-tinta underline decoration-acento decoration-2 underline-offset-4">
            Temas
          </a>
          {" › "}
          {tema.nome}
        </nav>
        <h1 class="er-rise font-display mt-4 text-3xl font-bold tracking-tight text-ink md:text-5xl">
          {tema.nome}
        </h1>
        <p class="er-rise er-rise-delay-1 mt-3 max-w-xl text-suave">{tema.descricao}</p>
        <p class="er-rise er-rise-delay-1 mt-2 text-sm text-suave">
          Últimos 15 dias · fonte:
          <a
            href="https://www.doe.sp.gov.br"
            class="font-medium text-tinta underline decoration-acento decoration-2 underline-offset-4"
          >
            doe.sp.gov.br
          </a>
        </p>

        {
          publicacoes.length === 0 ? (
            <Card class="mt-10">
              <p class="font-semibold">Nada nos últimos 15 dias</p>
              <p class="mt-1 text-suave">
                Nenhuma publicação deste tema no período — e isso também conta.
                Volte amanhã, ou peça aviso por e-mail quando sair.
              </p>
            </Card>
          ) : (
            <div class="er-trilha mt-10">
              {[...porDia.entries()].map(([dia, doDia]) => (
                <section class="er-dia pb-8 last:pb-0">
                  <h2 class="font-display text-sm font-bold uppercase tracking-wider text-suave">
                    {dia}
                    <span class="ml-2 rounded-sm bg-campo px-1.5 py-0.5 text-xs font-bold tabular-nums normal-case tracking-normal text-slate">
                      {doDia.length}
                    </span>
                  </h2>
                  <ul class="mt-3 space-y-3">
                    {doDia.map((p) => (
                      <li class="er-card er-lift">
                        <p class="font-semibold">{humanizarTitulo(p.titulo)}</p>
                        {orgaoDe(p.hierarchy) && (
                          <p class="mt-0.5 text-xs uppercase tracking-wide text-suave">{orgaoDe(p.hierarchy)}</p>
                        )}
                        {p.excerpt && <p class="mt-2 text-sm text-suave">{p.excerpt.slice(0, 220)}…</p>}
                        <a
                          class="mt-3 inline-block text-sm font-medium text-tinta underline decoration-acento decoration-2 underline-offset-4"
                          href={`https://www.doe.sp.gov.br/${p.slug}`}
                        >
                          ver na fonte
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          )
        }

        <Card class="mt-10 bg-acento-suave">
          <p class="font-display text-lg font-bold tracking-tight text-ink">Não dá pra checar isso todo dia?</p>
          <p class="mt-1 text-sm text-suave">
            A gente avisa por e-mail quando sair {tema.nome.toLowerCase()} — ou
            qualquer assunto que você quiser acompanhar. Grátis.
          </p>
          <a
            href="/entrar"
            class="mt-5 inline-block rounded-sm bg-acento px-5 py-2.5 font-semibold text-sobre-acento transition-colors hover:bg-acento-forte"
          >
            Quero receber no e-mail
          </a>
        </Card>

      </main>
      <SiteFooter />
    </Base>
  )
}
