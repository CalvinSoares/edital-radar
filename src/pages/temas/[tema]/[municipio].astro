---
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import Card from "~/components/ui/Card.astro";
import { temaPorSlug } from "~/server/match/temas";
import { humanizarSlugMunicipio, slugMunicipioValido } from "~/server/seo/municipio";
import { humanizarTitulo } from "~/server/alerta/render";

export const prerender = false;

const tema = temaPorSlug(Astro.params.tema ?? "");
const municipioSlug = (Astro.params.municipio ?? "").toLowerCase();
const municipioOk = slugMunicipioValido(municipioSlug);

if (!tema || !municipioOk) {
  Astro.response.status = 404;
}

const nomeMun = humanizarSlugMunicipio(municipioSlug);
const { db } = await import("~/server/db/cliente");
const { listarPorTemaEMunicipio } = await import("~/server/db/repositorios/municipios");
const publicacoes =
  tema && municipioOk ? await listarPorTemaEMunicipio(db, tema.slug, municipioSlug, 15) : [];

const formatoDia = new Intl.DateTimeFormat("pt-BR", {
  weekday: "long",
  day: "2-digit",
  month: "2-digit",
  timeZone: "America/Sao_Paulo",
});
const porDia = new Map<string, typeof publicacoes>();
for (const p of publicacoes) {
  const dia = formatoDia.format(p.dataPublicacao);
  porDia.set(dia, [...(porDia.get(dia) ?? []), p]);
}

if (tema && municipioOk) {
  Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=3600");
}
---

{
  !tema || !municipioOk ? (
    <Base titulo="Página não encontrada — Edital Radar" indexavel={false}>
      <SiteHeader ativo="temas" />
      <main class="mx-auto max-w-2xl px-4 py-24 text-center">
        <h1 class="font-display text-4xl font-bold tracking-tight text-ink">Essa página não existe</h1>
        <a href="/temas" class="mt-8 inline-block font-medium text-tinta underline decoration-acento decoration-2 underline-offset-4">
          Ver temas
        </a>
      </main>
    </Base>
  ) : (
    <Base
      titulo={`${tema.nome} em ${nomeMun} — Diário Oficial de SP | Edital Radar`}
      descricao={`${tema.descricao} Foco em ${nomeMun}, últimos 15 dias.`}
      tipoOg="article"
      jsonLd={{
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: `${tema.nome} em ${nomeMun}`,
        description: `${tema.descricao} Foco em ${nomeMun}.`,
        isPartOf: { "@type": "WebSite", name: "Edital Radar" },
      }}
    >
      <SiteHeader ativo="temas" />
      <main class="mx-auto max-w-2xl px-4 py-12 md:max-w-3xl md:py-16">
        <nav class="text-sm text-suave">
          <a href="/temas" class="font-medium text-tinta underline decoration-acento decoration-2 underline-offset-4">
            Temas
          </a>
          {" › "}
          <a href={`/temas/${tema.slug}`} class="hover:text-tinta">
            {tema.nome}
          </a>
          {" › "}
          {nomeMun}
        </nav>
        <h1 class="font-display mt-4 text-3xl font-bold tracking-tight text-ink md:text-5xl">
          {tema.nome} em {nomeMun}
        </h1>
        <p class="mt-3 text-suave">{tema.descricao}</p>
        <p class="mt-1 text-sm text-suave">
          Últimos 15 dias ·
          <a href={`/municipios/${municipioSlug}`} class="font-medium text-tinta underline decoration-clay decoration-2 underline-offset-4 hover:decoration-ink">
            ver tudo de {nomeMun}
          </a>
        </p>

        {publicacoes.length === 0 ? (
          <Card class="mt-8">
            <p class="font-semibold">Nada nos últimos 15 dias</p>
            <p class="mt-1 text-suave">
              Nenhuma publicação deste tema em {nomeMun} no período.
            </p>
          </Card>
        ) : (
          [...porDia.entries()].map(([dia, doDia]) => (
            <section class="mt-8">
              <h2 class="font-display text-lg font-semibold capitalize text-suave">{dia}</h2>
              <ul class="mt-3 space-y-3">
                {doDia.map((p) => (
                  <li class="er-card er-lift">
                    <p class="font-semibold">{humanizarTitulo(p.titulo)}</p>
                    {p.excerpt && <p class="mt-2 text-sm text-suave">{p.excerpt.slice(0, 220)}…</p>}
                    <a
                      class="mt-2 inline-block text-sm font-medium text-tinta underline decoration-clay decoration-2 underline-offset-4 hover:decoration-ink"
                      href={`https://www.doe.sp.gov.br/${p.slug}`}
                    >
                      ver na fonte
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        )}

        <Card class="mt-10 border-acento/30 bg-acento-suave">
          <p class="font-semibold">Receba {tema.nome.toLowerCase()} de {nomeMun} no e-mail</p>
          <a
            href="/entrar"
            class="mt-4 inline-block rounded-sm bg-acento px-5 py-2.5 font-semibold text-sobre-acento transition-colors hover:bg-acento-forte"
          >
            Quero receber no e-mail
          </a>
        </Card>
      </main>
    </Base>
  )
}
