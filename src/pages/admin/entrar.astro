---
import { actions, isInputError } from "astro:actions";
import Base from "~/layouts/Base.astro";
import Card from "~/components/ui/Card.astro";
import Field from "~/components/ui/Field.astro";
import Button from "~/components/ui/Button.astro";
import { adminAutenticado, adminConfigurado } from "~/shared/admin";

export const prerender = false;

if (adminAutenticado(Astro.cookies)) {
  return Astro.redirect("/admin");
}

const resultado = Astro.getActionResult(actions.admin.entrar);
if (resultado && !resultado.error) return Astro.redirect("/admin");
const erro = isInputError(resultado?.error)
  ? resultado.error.fields.senha?.[0]
  : resultado?.error?.message;
---

<Base titulo="Admin — Edital Radar">
  <main class="mx-auto max-w-md px-4 py-24">
    <p class="er-brand text-sm text-ink">Edital Radar · Admin</p>
    <h1 class="font-display mt-3 text-3xl font-bold tracking-tight text-ink">Entrar no admin</h1>
    {
      !adminConfigurado() ? (
        <Card class="mt-8">
          <p class="font-semibold">Admin desligado</p>
          <p class="mt-1 text-sm text-suave">
            Defina <code class="text-tinta">ADMIN_SECRET</code> no ambiente para habilitar.
          </p>
        </Card>
      ) : (
        <Card class="mt-8">
          <form method="POST" action={actions.admin.entrar} class="space-y-4">
            <Field name="senha" label="Senha de admin" type="password" erro={erro} />
            <Button>Entrar</Button>
          </form>
        </Card>
      )
    }
  </main>
</Base>
