---
import { actions } from "astro:actions";
import Admin from "~/layouts/Admin.astro";
import Badge from "~/components/ui/Badge.astro";
import { adminAutenticado } from "~/shared/admin";

export const prerender = false;

const saiu = Astro.getActionResult(actions.admin.sair);
if (saiu && !saiu.error) return Astro.redirect("/admin/entrar");

if (!adminAutenticado(Astro.cookies)) {
  return Astro.redirect("/admin/entrar");
}

const { db } = await import("~/server/db/cliente");
const { listarColetasAdmin } = await import("~/server/db/repositorios/admin");
const lista = await listarColetasAdmin(db, 40);

const formato = new Intl.DateTimeFormat("pt-BR", {
  day: "2-digit",
  month: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "America/Sao_Paulo",
});

const varianteStatus: Record<string, "ok" | "neutro" | "urgente"> = {
  ok: "ok",
  sem_edicao: "neutro",
  erro: "urgente",
};
---

<Admin titulo="Coletas" ativo="coletas">
  {
    lista.length === 0 ? (
      <p class="mt-8 text-suave">Nenhuma execução registrada.</p>
    ) : (
      <div class="mt-6 overflow-x-auto er-card-quiet">
        <table class="er-table min-w-[720px]">
          <thead>
            <tr>
              <th>Quando</th>
              <th>Dia alvo</th>
              <th>Status</th>
              <th>Coletado</th>
              <th>Casado</th>
              <th>Enviado</th>
              <th>Erro</th>
            </tr>
          </thead>
          <tbody>
            {lista.map((c) => (
              <tr>
                <td class="whitespace-nowrap text-suave">{formato.format(c.executadoEm)}</td>
                <td class="font-medium">{c.dataAlvo}</td>
                <td>
                  <Badge variante={varianteStatus[c.status] ?? "neutro"}>{c.status}</Badge>
                </td>
                <td class="tabular-nums">{c.totalColetado}</td>
                <td class="tabular-nums">{c.totalCasado}</td>
                <td class="tabular-nums">{c.totalEnviado}</td>
                <td class="max-w-xs truncate text-suave" title={c.erro ?? undefined}>
                  {c.erro ?? "—"}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</Admin>
