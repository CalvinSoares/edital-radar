---
import { actions, isInputError } from "astro:actions";
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import Card from "~/components/ui/Card.astro";
import Field from "~/components/ui/Field.astro";
import Button from "~/components/ui/Button.astro";
import { obterSessaoAtiva } from "~/shared/sessao";

export const prerender = false;

const sessao = await obterSessaoAtiva(Astro.cookies);
if (sessao) return Astro.redirect("/painel");

const resultado = Astro.getActionResult(actions.assinante.cadastrar);
if (resultado && !resultado.error) {
  return Astro.redirect("/entrar?enviado=1");
}
const erroEmail = isInputError(resultado?.error)
  ? resultado.error.fields.email?.[0]
  : resultado?.error?.message;

const enviado = Astro.url.searchParams.get("enviado") === "1";
---

<Base titulo="Entrar — Edital Radar" indexavel={false}>
  <SiteHeader ativo="entrar" compacto />
  <main class="mx-auto max-w-md px-4 py-14 md:py-20">
    <h1 class="er-rise font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">
      {enviado ? "Olha o e-mail" : "Entra sem senha"}
    </h1>
    <p class="er-rise er-rise-delay-1 mt-3 text-suave">
      {
        enviado
          ? "Mandamos um link de acesso. Vale 15 minutos e só funciona uma vez."
          : "A gente manda um link no seu e-mail. Se for a primeira vez, a conta já nasce aí."
      }
    </p>

    <Card class="er-rise er-rise-delay-2 mt-8">
      {
        enviado ? (
          <>
            <p class="font-semibold text-tinta">Não chegou?</p>
            <p class="mt-1 text-suave">
              Confere o spam. Ou
              <a href="/entrar" class="font-medium text-tinta underline decoration-acento decoration-2 underline-offset-4">
                {" "}pede de novo
              </a>.
            </p>
          </>
        ) : (
          <form method="POST" action={actions.assinante.cadastrar} class="space-y-5">
            <Field
              name="email"
              label="Seu e-mail"
              type="email"
              placeholder="voce@suaong.org"
              erro={erroEmail}
            />
            <Button radar>Manda o link</Button>
          </form>
        )
      }
    </Card>
  </main>
</Base>
