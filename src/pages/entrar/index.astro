---
import { actions, isInputError } from "astro:actions";
import Base from "~/layouts/Base.astro";
import Card from "~/components/ui/Card.astro";
import Field from "~/components/ui/Field.astro";
import Button from "~/components/ui/Button.astro";
import { obterSessaoAtiva } from "~/shared/sessao";

export const prerender = false;

// Já logado? Direto ao painel.
const sessao = await obterSessaoAtiva(Astro.cookies);
if (sessao) return Astro.redirect("/painel");

const resultado = Astro.getActionResult(actions.assinante.cadastrar);
if (resultado && !resultado.error) {
  return Astro.redirect("/entrar?enviado=1"); // PRG: F5 não reenvia
}
const erroEmail = isInputError(resultado?.error)
  ? resultado.error.fields.email?.[0]
  : resultado?.error?.message;

const enviado = Astro.url.searchParams.get("enviado") === "1";
---

<Base titulo="Entrar — Edital Radar">
  <main class="mx-auto max-w-md px-4 py-24">
    <h1 class="font-display text-3xl font-bold text-acento">Entrar no Edital Radar</h1>
    <p class="mt-2 text-suave">
      Sem senha: você recebe um link de acesso no e-mail. Se for sua primeira
      vez, a conta é criada na hora.
    </p>

    <Card class="mt-8">
      {
        enviado ? (
          <>
            <p class="font-semibold">Confira seu e-mail</p>
            <p class="mt-1 text-suave">
              Enviamos um link de acesso. Ele vale por 15 minutos e funciona
              uma única vez. Não chegou? Olhe o spam ou tente de novo.
            </p>
          </>
        ) : (
          <form method="POST" action={actions.assinante.cadastrar} class="space-y-4">
            <Field
              name="email"
              label="Seu e-mail"
              type="email"
              placeholder="voce@suaong.org"
              erro={erroEmail}
            />
            <Button>Enviar link de acesso</Button>
          </form>
        )
      }
    </Card>
  </main>
</Base>
