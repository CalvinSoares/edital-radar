# Postgres (Neon/Supabase/local)
DATABASE_URL=postgres://usuario:senha@localhost:5432/edital_radar

# Secret do endpoint POST /api/coleta (cron da Vercel envia no header)
COLETA_SECRET=troque-por-um-valor-longo-aleatorio

# E-mail (Resend). RESEND_MODE=real só em produção.
RESEND_API_KEY=
RESEND_MODE=dry-run
EMAIL_REMETENTE=Edital Radar <avisos@editalradar.com.br>
# Signing secret do webhook (Svix) — bounce/reclamação → supressão
RESEND_WEBHOOK_SECRET=

# URL pública do site (links do e-mail: fonte e descadastro)
SITE_URL=http://localhost:4321

# Destinatário interno do alarme do job (0 pubs em dia útil, falha de coleta)
ALARME_EMAIL=

# Senha do backoffice interno (/admin). Sem ela, as rotas ficam desligadas.
ADMIN_SECRET=
